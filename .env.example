# Elite Harvest Global - Environment Variables
# Copy this file to .env.local and fill in your values

# Google Maps uses a no-key embed. Set a complete, publicly searchable address
# so the location and Get Directions button point to the correct place.

# Company Information
NEXT_PUBLIC_COMPANY_NAME="Elite Harvest Global"
NEXT_PUBLIC_COMPANY_TAGLINE="Agriculture and Global Trade"
NEXT_PUBLIC_COMPANY_EMAIL="info@eliteharvestglobal.com"
NEXT_PUBLIC_COMPANY_PHONE_PRIMARY="+918602722245"
NEXT_PUBLIC_COMPANY_PHONE_SECONDARY="+919752823426"
NEXT_PUBLIC_COMPANY_WHATSAPP="+918602722245"
# Replace with the verified office address before production deployment.
NEXT_PUBLIC_COMPANY_ADDRESS="India"
NEXT_PUBLIC_COMPANY_DOMAIN="https://eliteharvestglobal.com"

# Contact Form Configuration
# For email integration, you can use services like Resend, SendGrid, Nodemailer, etc.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# CONTACT_EMAIL_TO=info@eliteharvestglobal.com
# CONTACT_EMAIL_FROM=noreply@eliteharvestglobal.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=
